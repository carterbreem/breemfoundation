// ─────────────────────────────────────────────────────────
// Breem Foundation — Prisma Schema
// Database: PostgreSQL (Supabase)
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum UserRole {
  APPLICANT
  ADMIN
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFO_REQUIRED
}

enum AssistanceType {
  FINANCIAL
  FOOD
  HOUSING
  MEDICAL
  EDUCATION
  EMERGENCY
  OTHER
}

enum DonationStatus {
  PENDING_PAYMENT
  PAYMENT_DETAILS_SENT
  COMPLETED
  CANCELLED
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_APP
  PAYPAL
  ZELLE
  VENMO
  OTHER
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum DocumentKind {
  SUPPORTING
  PHOTO
  ADDITIONAL
}

// ─────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String?
  role          UserRole  @default(APPLICANT)
  emailVerified DateTime?
  image         String?

  // Relations
  accounts     Account[]
  sessions     Session[]
  applications Application[]
  messages     Message[]     @relation("MessageAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────
// APPLICATIONS
// ─────────────────────────────────────────────────────────

model Application {
  id                String            @id @default(cuid())
  referenceNumber   String            @unique
  status            ApplicationStatus @default(SUBMITTED)

  // Applicant link (optional — allows applicant portal login)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal info
  fullName      String
  dateOfBirth   DateTime
  gender        String
  email         String
  phone         String

  // Location
  country   String
  state     String
  city      String
  homeAddress String

  // Status info
  maritalStatus    String
  employmentStatus String

  // Assistance
  assistanceType AssistanceType
  amountRequested Float?
  needExplanation String  @db.Text
  howItHelps      String  @db.Text
  receivedBefore  Boolean @default(false)
  receivedBeforeDetails String? @db.Text

  // Admin
  adminNotes      String?   @db.Text
  reviewedAt      DateTime?
  reviewedByEmail String?

  // Relations
  documents Document[]
  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([referenceNumber])
  @@index([createdAt])
  @@map("applications")
}

// ─────────────────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────────────────

model Document {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind          DocumentKind @default(SUPPORTING)
  fileName      String
  fileSize      Int
  mimeType      String
  storagePath   String       // path in Supabase storage bucket
  uploadedBy    String?      // email or "applicant" / "admin"

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────
// MESSAGES (admin ↔ applicant)
// ─────────────────────────────────────────────────────────

model Message {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  authorRole UserRole
  body       String   @db.Text
  readByApplicant Boolean @default(false)
  readByAdmin     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────
// DONATIONS
// ─────────────────────────────────────────────────────────

model Donation {
  id              String            @id @default(cuid())
  referenceNumber String            @unique
  status          DonationStatus    @default(PENDING_PAYMENT)
  frequency       DonationFrequency @default(ONE_TIME)

  // Donor info
  donorName    String
  donorEmail   String
  donorPhone   String?
  anonymous    Boolean           @default(false)
  amount       Float
  currency     String            @default("USD")
  paymentMethod PaymentMethod
  dedicationMessage String?      @db.Text

  // Admin workflow
  paymentDetailsSentAt DateTime?
  paymentDetailsSentBy String?
  completedAt          DateTime?
  adminNotes           String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([donorEmail])
  @@index([createdAt])
  @@map("donations")
}

// ─────────────────────────────────────────────────────────
// CONTACT MESSAGES
// ─────────────────────────────────────────────────────────

model ContactMessage {
  id      String        @id @default(cuid())
  name    String
  email   String
  subject String
  message String        @db.Text
  status  ContactStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─────────────────────────────────────────────────────────
// CONTENT: SUCCESS STORIES
// ─────────────────────────────────────────────────────────

model SuccessStory {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String   @db.Text
  content       String   @db.Text
  imageUrl      String
  beneficiaryName String
  location      String?
  assistanceType AssistanceType?
  amountAwarded Float?
  published     Boolean  @default(true)
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@map("success_stories")
}

// ─────────────────────────────────────────────────────────
// CONTENT: TESTIMONIALS
// ─────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?  // e.g. "Beneficiary", "Donor", "Volunteer"
  location  String?
  quote     String   @db.Text
  avatarUrl String?
  rating    Int      @default(5)
  published Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@map("testimonials")
}

// ─────────────────────────────────────────────────────────
// CONTENT: FAQs
// ─────────────────────────────────────────────────────────

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General")
  published Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@map("faqs")
}

// ─────────────────────────────────────────────────────────
// CONTENT: SITE STATS (for Home page counters)
// ─────────────────────────────────────────────────────────

model SiteStat {
  id        String   @id @default(cuid())
  key       String   @unique  // "families_helped", "donations_received", "active_volunteers"
  label     String
  value     Int
  suffix    String?  // "+", "K", "%"
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("site_stats")
}

// ─────────────────────────────────────────────────────────
// VISITOR LOG (for analytics, not for Telegram — that's fire & forget)
// ─────────────────────────────────────────────────────────

model Visit {
  id         String   @id @default(cuid())
  visitorId  String
  country    String?
  entry      String?
  userAgent  String?  @db.Text
  path       String?
  visitCount Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
  @@map("visits")
}
