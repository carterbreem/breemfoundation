// Breem Foundation — Prisma schema
// Provider: PostgreSQL (Supabase)
// Generated client: @prisma/client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────────────────

enum UserRole {
  APPLICANT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(APPLICANT)
  emailVerified DateTime?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  application   Application?
  sessions      Session[]
  sentMessages  Message[]   @relation("SentMessages")
  tokens        VerificationToken[]

  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────
// APPLICATIONS
// ─────────────────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
}

enum AssistanceType {
  FINANCIAL
  FOOD
  HOUSING
  MEDICAL
  EDUCATION
  EMERGENCY
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Application {
  id                 String            @id @default(cuid())
  referenceNumber    String            @unique
  userId             String?           @unique
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal
  fullName           String
  dateOfBirth        DateTime
  gender             Gender
  email              String
  phone              String
  maritalStatus      String
  employmentStatus   String

  // Location
  country            String
  state              String
  city               String
  homeAddress        String

  // Assistance
  assistanceType     AssistanceType
  amountRequested    Decimal?          @db.Decimal(12, 2)
  needExplanation    String            @db.Text
  howItWillHelp      String            @db.Text
  receivedBefore     Boolean           @default(false)
  receivedBeforeNote String?           @db.Text

  // Status & review
  status             ApplicationStatus @default(SUBMITTED)
  adminNotes         String?           @db.Text
  reviewedAt         DateTime?
  reviewedById       String?

  // Meta
  submittedIp        String?
  submittedUserAgent String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Relations
  documents          Document[]
  messages           Message[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("applications")
}

// ─────────────────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────────────────

enum DocumentKind {
  SUPPORTING
  APPLICANT_PHOTO
  ADDITIONAL
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Document {
  id            String         @id @default(cuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  status        DocumentStatus @default(PENDING)
  uploadedAt    DateTime       @default(now())

  @@index([applicationId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────
// MESSAGES (admin <-> applicant)
// ─────────────────────────────────────────────────────────

model Message {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?       @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  body          String      @db.Text
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────
// DONATIONS
// ─────────────────────────────────────────────────────────

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_APP
  PAYPAL
  ZELLE
  VENMO
  OTHER
}

enum DonationStatus {
  PENDING_PAYMENT
  PAYMENT_DETAILS_SENT
  COMPLETED
  CANCELLED
  REFUNDED
}

model Donation {
  id               String            @id @default(cuid())
  referenceNumber  String            @unique

  // Donor
  donorName        String
  donorEmail       String
  isAnonymous      Boolean           @default(false)

  // Amount & type
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("USD")
  frequency        DonationFrequency @default(ONE_TIME)

  // Payment
  paymentMethod    PaymentMethod
  status           DonationStatus    @default(PENDING_PAYMENT)
  detailsSentAt    DateTime?
  detailsSentById  String?
  completedAt      DateTime?

  // Dedication
  dedication       String?           @db.Text

  // Admin notes
  adminNotes       String?           @db.Text

  // Meta
  submittedIp      String?
  submittedUserAgent String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([donorEmail])
  @@index([createdAt])
  @@map("donations")
}

// ─────────────────────────────────────────────────────────
// CONTENT: Success Stories, Testimonials, FAQs
// ─────────────────────────────────────────────────────────

model SuccessStory {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String   @db.Text
  content        String   @db.Text
  imageUrl       String
  personName     String
  location       String?
  assistanceType AssistanceType?
  amountAwarded  Decimal? @db.Decimal(12, 2)
  published      Boolean  @default(true)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, featured])
  @@map("success_stories")
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String?
  location   String?
  quote      String   @db.Text
  avatarUrl  String?
  rating     Int      @default(5)
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, category])
  @@map("faqs")
}

// ─────────────────────────────────────────────────────────
// CONTACT MESSAGES
// ─────────────────────────────────────────────────────────

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─────────────────────────────────────────────────────────
// ANALYTICS: Site visits
// ─────────────────────────────────────────────────────────

model Visit {
  id        String   @id @default(cuid())
  visitorId String
  country   String?
  entry     String?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
  @@map("visits")
}

// ─────────────────────────────────────────────────────────
// SITE CONTENT (key-value for CMS features)
// ─────────────────────────────────────────────────────────

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// ─────────────────────────────────────────────────────────
// ADMIN ACTION LOG
// ─────────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_logs")
}
