# ─────────────────────────────────────────────────────────
# Breem Foundation — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Prisma) ────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── Admin Credentials (PRIVATE — never shown in UI) ──────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Public Contact ───────────────────────────────────────
CONTACT_EMAIL=breemsfoundation.org@proton.me

# ── Telegram Visitor Alerts ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Breem Foundation
NEXT_PUBLIC_TAX_ID=74-2655302

# ── Auth ─────────────────────────────────────────────────
AUTH_SECRET=generate-a-long-random-string-here
AUTH_URL=http://localhost:3000
