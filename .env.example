# ─────────────────────────────────────────────────────────
# Breem Foundation — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Prisma) ────────────────────────────────────
# Add ?pgbouncer=true&connection_limit=1 to DATABASE_URL to avoid
# "prepared statement already exists" errors with Supabase pooler.
DATABASE_URL=
DIRECT_URL=

# ── Admin Credentials (PRIVATE — never shown in UI) ──────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Public Contact + Tax ─────────────────────────────────
CONTACT_EMAIL=breemsfoundation.org@proton.me
NEXT_PUBLIC_TAX_ID=74-2655302

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Breem Foundation

# ── Auth ─────────────────────────────────────────────────
# Generate with: https://generate-secret.vercel.app/32
AUTH_SECRET=

# ── Telegram Visitor Alerts (Optional) ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
